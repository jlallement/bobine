{
  "name": "bobine",
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "Jérôme Lallement",
  "homepage": "https://github.com/jlallement/bobine",
  "bugs": {
    "url": "https://github.com/jlallement/bobine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlallement/bobine.git"
  },
  "description": "Bobine: desktop app for ACP coding agents (IBM Bob first, OpenCode)",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "predev": "./scripts/check-electron && (./scripts/fetch-axe || echo '⚠ AXe non extrait : pas de touchers ni de vidéo dans le simulateur (détail : pnpm fetch-axe)')",
    "preview": "electron-vite preview",
    "prepreview": "./scripts/check-electron && (./scripts/fetch-axe || echo '⚠ AXe non extrait : pas de touchers ni de vidéo dans le simulateur (détail : pnpm fetch-axe)')",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-types.mts && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "i18n-types": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-types.mts",
    "themes-css": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/themes-css.mts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mock-agent": "node src/mock-agent/main.mts",
    "guide-shortcuts": "BOBINE_WRITE_GUIDE=1 vitest run --project node scripts/guide-shortcuts.test.ts",
    "e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/run.mjs",
    "e2e:pretag": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/run.mjs --if-needed",
    "fetch-axe": "./scripts/fetch-axe",
    "electron-local": "./scripts/electron-local",
    "simulator-smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulator-smoke.mts",
    "bob-probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bob-probe.mts",
    "opencode-probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/opencode-probe.mts",
    "package": "./scripts/package",
    "e2e:packaged": "node e2e/packaged.mjs",
    "pilote": "node scripts/pilote/pilote.mjs",
    "third-party-notices": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/third-party-notices.mts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^9.0.0",
    "electron": "^45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "i18next": "27.0.1",
    "ignore": "7.0.14",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.70.0",
    "mermaid": "12.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.1.0"
  }
}
