/**
 * Rédaction de `THIRD-PARTY-NOTICES.md` (fiche 217) : en anglais, comme le reste des fichiers
 * légaux du dépôt, et livré avec l'app. Fonction pure : mêmes entrées, même texte (pas de date),
 * pour que le contrôle de dérive compare au caractère près.
 */
import type { PackageLicense } from './packages.mts'

/** Un composant hors npm (police, jeux d'icônes) et ses textes de licence. */
export interface ExtraComponent {
  name: string
  license: string
  texts: string[]
}

export interface NoticesInput {
  /** Paquets npm livrés, avec l'endroit où ils servent. */
  packages: (PackageLicense & { where: string })[]
  electron: PackageLicense
  /** Version d'AXe livrée avec l'app macOS. */
  axeVersion: string
  font: {
    nerdFontsVersion: string
    /** Tableau « Icon sets » du README de la police, tel quel. */
    iconSets: string
    meslo: ExtraComponent
    nerdFonts: ExtraComponent
    /** Texte CC BY 4.0 (Codicons, Font Awesome) et OFL 1.1 (Pomicons, Weather Icons). */
    ccBy: ExtraComponent
    ofl: ExtraComponent
  }
}

interface TextGroup {
  text: string
  users: string[]
}

/** Clôture de bloc de code plus longue que toute suite d'accents graves du texte. */
function fence(text: string): string {
  const longest = Math.max(0, ...[...text.matchAll(/`+/g)].map((m) => m[0].length))
  return '`'.repeat(Math.max(3, longest + 1))
}

/** Textes identiques regroupés (un MIT par auteur reste distinct : l'avis de copyright compte). */
export function groupTexts(components: { label: string; texts: string[] }[]): TextGroup[] {
  const groups = new Map<string, TextGroup>()
  for (const c of components) {
    const text = c.texts.join('\n\n---\n\n')
    const group = groups.get(text) ?? { text, users: [] }
    group.users.push(c.label)
    groups.set(text, group)
  }
  return [...groups.values()]
}

const label = (p: { name: string; version: string }): string => `${p.name} ${p.version}`
const escapeCell = (s: string): string => s.replaceAll('|', '\\|')

const HEADER = `# Third-party notices

<!-- Generated by \`pnpm third-party-notices\` (scripts/third-party-notices.mts, feature 217) from
what the build puts in the app. Do not edit by hand: run \`pnpm build && pnpm third-party-notices\`. -->

Bobine is licensed under the Apache License 2.0 (see \`LICENSE\` and \`NOTICE\`). The app ships the
third-party software listed below; each component keeps its own license. This file ships with the
app, next to Bobine's \`LICENSE\` and \`NOTICE\`: \`Bobine.app/Contents/Resources/licenses/\` on macOS,
\`resources/licenses/\` on Linux.`

function electronSection(electron: PackageLicense, textIds: Map<string, number>): string {
  const id = textIds.get(label(electron))
  return `## Electron and Chromium

Bobine runs on [Electron](https://www.electronjs.org) ${electron.version} (MIT, license text
[T${id}](#t${id})), which embeds Chromium, Node.js and their components. Their licenses are in
\`LICENSES.chromium.html\`, shipped with the app in \`licenses/electron/\` together with Electron's
\`LICENSE\`.`
}

function packagesSection(input: NoticesInput, textIds: Map<string, number>): string {
  const rows = input.packages.map((p) => {
    const id = textIds.get(label(p))
    const name = p.repository ? `[${p.name}](${p.repository})` : p.name
    return `| ${escapeCell(name)} | ${p.version} | ${escapeCell(p.license)} | ${p.where} | [T${id}](#t${id}) |`
  })
  return `## npm packages shipped in the app

${input.packages.length} packages, copied into the app by the build (\`out/\`: main process,
interface) or added by the packager (production dependencies, \`app.asar\`). Development tools
that ship nothing (compilers, test runners, linters, the packager itself) are not listed; Vite
and Rolldown are, for the small runtime helpers they add to the build output.

| Package | Version | License | Used by | License text |
|---|---|---|---|---|
${rows.join('\n')}`
}

function choicesSection(packages: PackageLicense[]): string {
  const chosen = packages.filter((p) => p.offered)
  const lines = chosen.map(
    (p) =>
      `- **${p.name} ${p.version}** is offered under \`${p.offered}\`; Bobine distributes it under ` +
      `**${p.license}**. It is not modified. Source code: ${p.source} (version ${p.version}).`
  )
  return `## Dual-licensed packages: license chosen

${lines.join('\n')}`
}

function axeSection(version: string): string {
  return `## AXe and idb (macOS app only)

[AXe](https://github.com/cameroncooke/AXe) ${version} (iOS Simulator automation: taps, screen
reading, video), MIT — Copyright (c) 2025 Cameron Cooke, ships in \`Contents/Resources/axe\` with
the [idb](https://github.com/facebook/idb) frameworks it bundles (FBControlCore, FBDeviceControl,
XCTestBootstrap), MIT — Copyright (c) Meta Platforms, Inc. and affiliates. Their full license texts
ship with them: \`Contents/Resources/axe/LICENSES.txt\` (in the repository:
\`vendor/archives/AXe-${version}-LICENSES.txt\`).`
}

function fontSection(input: NoticesInput, textIds: Map<string, number>): string {
  const ref = (name: string): string => {
    const id = textIds.get(name)
    return `[T${id}](#t${id})`
  }
  const { meslo, nerdFonts, ccBy, ofl } = input.font
  return `## MesloLGS Nerd Font

One font is embedded: MesloLGS Nerd Font Regular, from the
[Nerd Fonts](https://github.com/ryanoasis/nerd-fonts) release v${input.font.nerdFontsVersion}, used
by the terminal panel only for icons missing from the other fonts. The font file is shipped as
published, unmodified.

- Meslo LG (Copyright 2009, 2010, 2013 André Berg), ${meslo.license}: ${ref(meslo.name)}.
- Nerd Fonts patcher (Copyright (c) 2014 Ryan L McIntyre), ${nerdFonts.license}: ${ref(nerdFonts.name)}.
- Icon sets merged into the font by Nerd Fonts, each under its own license (table from the font's
  README):

${input.font.iconSets}

Attributions. The Codicons glyphs are © Microsoft Corporation and the Font Awesome glyphs are
© Fonticons, Inc. (https://fontawesome.com); both are licensed under the Creative Commons
Attribution 4.0 International license (https://creativecommons.org/licenses/by/4.0/,
${ref(ccBy.name)}). Nerd Fonts rescaled and repositioned these glyphs to fit the font; Bobine
does not modify them further. Pomicons (Reserved Font Name "Pomicons") and Weather Icons are
licensed under the SIL Open Font License 1.1 (${ref(ofl.name)}). The other icon sets are under
the licenses listed in the table.`
}

const OTHER = `## Interface fonts, icons and artwork

- **Fonts**: the interface uses the system fonts of macOS (SF Pro, New York, SF Mono) through
  generic CSS families; nothing is embedded besides the font above.
- **Icons**: [Lucide](https://lucide.dev) (\`lucide-react\`, listed above).
- **App icon** (\`build/icon.svg\`) and **install background** (\`build/background.svg\`): the
  project's own work, under Bobine's license.

## Not bundled

IBM Bob and OpenCode are separate programs installed by the user; Bobine starts them over ACP
(Agent Client Protocol) and embeds nothing of theirs.`

function textsSection(groups: TextGroup[]): string {
  const parts = groups.map((g, i) => {
    const f = fence(g.text)
    return `### T${i + 1}

Used by: ${g.users.join(', ')}.

${f}text
${g.text}
${f}`
  })
  return `## License texts

Identical texts are printed once. When a package ships a NOTICE file, it follows its license,
after a \`---\` line.

${parts.join('\n\n')}`
}

/** Le fichier complet. */
export function renderNotices(input: NoticesInput): string {
  const components = [
    { label: label(input.electron), texts: input.electron.texts },
    ...input.packages.map((p) => ({ label: label(p), texts: [...p.texts, ...p.notices] })),
    ...[input.font.meslo, input.font.nerdFonts, input.font.ccBy, input.font.ofl].map((c) => ({
      label: c.name,
      texts: c.texts
    }))
  ]
  const groups = groupTexts(components)
  const textIds = new Map<string, number>()
  groups.forEach((g, i) => g.users.forEach((u) => textIds.set(u, i + 1)))
  return (
    [
      HEADER,
      electronSection(input.electron, textIds),
      packagesSection(input, textIds),
      choicesSection(input.packages),
      axeSection(input.axeVersion),
      fontSection(input, textIds),
      OTHER,
      textsSection(groups)
    ].join('\n\n') + '\n'
  )
}
