#!/usr/bin/env bash
# Lance une commande avec un gestionnaire de fenêtres léger (openbox) sur l'écran X courant
# (fiche 145). Sous `xvfb` nu, aucune fenêtre n'est jamais agrandie ni ne reçoit le focus : les
# essais e2e qui en dépendent échoueraient pour une raison étrangère à l'app.
#
#   xvfb-run -a -s "-screen 0 1920x1200x24" scripts/with-wm pnpm e2e startup
#
# Utilisé par le job Linux de `e2e.yml` et par `pnpm e2e:linux` (conteneur).
set -euo pipefail
[[ -n "${DISPLAY:-}" ]] || { echo "with-wm : pas d'écran X (DISPLAY), à lancer sous xvfb-run" >&2; exit 2; }
command -v openbox >/dev/null || { echo "with-wm : openbox introuvable" >&2; exit 2; }

# Sortie d'openbox gardée : s'il s'arrête au démarrage, elle dit pourquoi (fiche 250).
log=$(mktemp "${TMPDIR:-/tmp}/with-wm.XXXXXX")
wm=
trap 'kill "$wm" 2>/dev/null || true; rm -f "$log"' EXIT

# Prêt quand il s'annonce sur la fenêtre racine (norme EWMH), 10 s au plus. Arrêté au démarrage :
# relancé deux fois au plus, sa sortie dite à chaque fois. Sur le job Linux de GitHub, 3 passages
# sur 14 perdaient ainsi une suite entière (« 0 s ») sans rien en dire ; c'est l'écran de l'essai
# qui manquait, pas l'app (fiche 250).
start_wm() {
  openbox --sm-disable >"$log" 2>&1 &
  wm=$!
  for _ in $(seq 100); do
    xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id' && return 0
    kill -0 "$wm" 2>/dev/null || return 1
    sleep 0.1
  done
  return 0
}
for attempt in 1 2 3; do
  start_wm && break
  echo "with-wm : openbox s'est arrêté au démarrage (essai $attempt/3) : $(tr '\n' ' ' <"$log")" >&2
  [[ $attempt -eq 3 ]] && exit 2
  sleep 0.5
done

"$@"
