#!/usr/bin/env bash
# Contrat de "fini" : doit passer avant de déclarer une tâche terminée (voir AGENTS.md).
set -euo pipefail
cd "$(dirname "$0")/.."

fail=0
step() { printf '\n▶ %s\n' "$1"; }

step "Documentation"
for f in AGENTS.md CLAUDE.md docs/README.md docs/architecture.md docs/adr/README.md docs/features/README.md; do
  [[ -f "$f" ]] || { echo "  ✗ manquant : $f"; fail=1; }
done
# Chaque fiche (hors modèle) doit être référencée dans l'index
for f in docs/features/[0-9]*.md; do
  [[ -e "$f" ]] || continue
  name=$(basename "$f")
  grep -q "($name)" docs/features/README.md || { echo "  ✗ fiche absente de l'index : $name"; fail=1; }
done
# Idem pour les ADR
for f in docs/adr/[0-9]*.md; do
  [[ -e "$f" ]] || continue
  name=$(basename "$f")
  grep -q "($name)" docs/adr/README.md || { echo "  ✗ ADR absent de l'index : $name"; fail=1; }
done
[[ $fail -eq 0 ]] && echo "  ✓ ok"

if [[ -f package.json ]]; then
  step "Lint";      pnpm -s lint      || fail=1
  step "Typecheck"; pnpm -s typecheck || fail=1
  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    # En CI (fiche 250) : rapport JSON en plus, puis machine, workers et essais les plus lents,
    # que les tests passent ou non (un rouge par délai dépassé devient lisible).
    # Chemin relatif, dans un dossier ignoré : le même pour bash et node sous Windows.
    report="node_modules/.vitest-report.json"
    step "Tests"; pnpm -s test --reporter=default --reporter=json --outputFile.json="$report" || fail=1
    step "Relevé des tests"
    node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-report.mts "$report" 10 || true
    rm -f "$report"
  else
    step "Tests";     pnpm -s test      || fail=1
  fi
else
  echo -e "\n(pas encore de package.json : lint/typecheck/tests ignorés — voir fiche 001)"
fi

if [[ $fail -ne 0 ]]; then echo -e "\n✗ verify a échoué"; exit 1; fi
echo -e "\n✓ verify ok"
